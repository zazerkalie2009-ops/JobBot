u1072 \uc0\u1081 \uc0\u1085 , \uc0\u1082 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1099 \uc0\u1081  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1077 \uc0\u1090  \uc0\u1080  \uc0\u1074 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1072 \uc0\u1090 \uc0\u1083 \uc0\u1103 \uc0\u1077 \uc0\u1090 .{\line}{\line}\uc0\u1055 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1086  - https://www.behance.net/aleksandramart{\line}{\line}\uc0\u1042 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1102  Figma, Adobe CC (Photoshop, Illustrator, After Effects, InDesign, Lightroom), Tilda, PowerPoint, Cinema 4D.{\line}{\line}\uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1091 \uc0\u1102  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1092 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1099  \uc0\u1087 \uc0\u1086 \uc0\u1076  web \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1099 , \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1089  \uc0\u1075 \uc0\u1080 \uc0\u1087 \uc0\u1086 \uc0\u1090 \uc0\u1077 \uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1080 , \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1088 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1080 \uc0\u1089 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081 .{\line}{\line}\uc0\u1059 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086  \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1091  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1099  \uc0\u1086 \uc0\u1090  \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1092 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 .{\line}{\line}\uc0\u1045 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1089 \uc0\u1086 \uc0\u1079 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  motion-\uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1080  \uc0\u1080  \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081 , \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1091 \uc0\u1084 \uc0\u1086 \uc0\u1074 , \uc0\u1073 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1099 \uc0\u1090 \uc0\u1080 \uc0\u1081 .{\line}{\line}\uc0\u1054 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1077 :{\line}\uc0\u8226  ITMO University (2023) \uc0\u8212  Motion-\uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 {\line}\uc0\u8226  UPROCK School (2022) \uc0\u8212  UX/UI-\uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 {\line}\uc0\u8226  \uc0\u1061 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1096 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1072  (6 \uc0\u1083 \uc0\u1077 \uc0\u1090 ) + \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1099  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1088 \uc0\u1080 \uc0\u1089 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1072  (2 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 ){\line}{\line}\uc0\u1056 \uc0\u1080 \uc0\u1089 \uc0\u1091 \uc0\u1102  \uc0\u1086 \uc0\u1090  \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1080  \uc0\u1080  \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1096 \uc0\u1077 \uc0\u1090 \uc0\u1077 , \uc0\u1087 \uc0\u1080 \uc0\u1096 \uc0\u1091  \uc0\u1084 \uc0\u1072 \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1084 , \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1091 \uc0\u1102  \uc0\u1074  \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1082 \uc0\u1072 \uc0\u1093 .{\line}\uc0\u1041 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  10 \uc0\u1083 \uc0\u1077 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1102  \uc0\u1092 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1086 \uc0\u1084  \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1090 \uc0\u1091 \uc0\u1096 \uc0\u1105 \uc0\u1088 \uc0\u1086 \uc0\u1084 :{\line}\uc0\u8226  \uc0\u1055 \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1080  NIKON \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1080 \uc0\u1077  \uc0\u1092 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1099  2017, \uc0\u1085 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u171 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1099  \uc0\u8211  \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1084 \uc0\u1072 \uc0\u187 {\line}\uc0\u8226  \uc0\u1055 \uc0\u1088 \uc0\u1080 \uc0\u1079 \uc0\u1105 \uc0\u1088  35AWARDS{\line}\uc0\u8226  \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1092 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1086 \uc0\u1084  \uc0\u1080  \uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1084  \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1087 \uc0\u1087 \uc0\u1099  \uc0\u1041 \uc0\u1080 -2 | 2018 \uc0\u8212  2022{\line}{\line}\uc0\u1044 \uc0\u1086 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 :{\line}\uc0\u1042 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1102  \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1085 \uc0\u1077 \uc0\u1081 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1103 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 .{\line}}\cell\row\pard}