}\cell\pard\intbl\itap1{\fs50\b \uc0\u1052 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1099 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1072  \uc0\u1040 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1089 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1088 \uc0\u1072  }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1046 \uc0\u1077 \uc0\u1085 \uc0\u1097 \uc0\u1080 \uc0\u1085 \uc0\u1072 , 37\uc0\u160 \uc0\u1083 \uc0\u1077 \uc0\u1090 , \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1100  17 \uc0\u1084 \uc0\u1072 \uc0\u1103  1988}\par\pard\intbl\sl260{\fs18 \par +7\uc0\u160 (910)\uc0\u160 0150007 {\cf1\emdash  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073  \uc0\u1089 \uc0\u1074 \uc0\u1103 \uc0\u1079 \uc0\u1080 } {\cf1  \uc0\u8226  } {\cf1\uc0\u1058 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084  - kudavik}\par {{\field{\*\fldinst HYPERLINK "mailto:shu_mart@mail.ru"}{\fldrslt\ul shu_mart@mail.ru}}}\par \uc0\u1044 \uc0\u1088 \uc0\u1091 \uc0\u1075 \uc0\u1086 \uc0\u1081  \uc0\u1089 \uc0\u1072 \uc0\u1081 \uc0\u1090 : https://www.behance.net/aleksandramart}\par\pard\intbl\sl260{\fs18 \par \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1077 \uc0\u1090 : \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , \uc0\u1084 . \uc0\u1053 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1082 \uc0\u1086 \uc0\u1089 \uc0\u1080 \uc0\u1085 \uc0\u1086 \par \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 , \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1091 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 \par \uc0\u1043 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072  \uc0\u1082  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1077 \uc0\u1079 \uc0\u1076 \uc0\u1091 , \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072  \uc0\u1082  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \uc0\u1084 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1088 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1072 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa100\sl280{\fs24\b \uc0\u1044 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1077 \uc0\u1088  UX/UI }\pard\intbl\itap1\sl260{\fs18 \par{\uc0\u1057 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 :  }\par\li300{\uc0\u8212   \uc0\u1040 \uc0\u1088 \uc0\u1090 -\uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 , \uc0\u1082 \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 \par\uc0\u8212   \uc0\u1043 \uc0\u1077 \uc0\u1081 \uc0\u1084 -\uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1077 \uc0\u1088 \par\uc0\u8212   \uc0\u1044 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1077 \uc0\u1088 , \uc0\u1093 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1080 \uc0\u1082 }\par\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1047 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 : \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 , \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \par \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1100 , \uc0\u1075 \uc0\u1080 \uc0\u1073 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 , \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \par \line\uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1074  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1085 \uc0\u1077  \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1077 \uc0\u1090  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }}\cell \row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \emdash 13 \uc0\u1083 \uc0\u1077 \uc0\u1090  8 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1071 \uc0\u1085 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1100  2023 \emdash  \uc0\u1052 \uc0\u1072 \uc0\u1081  2025\line 2 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  5 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\par\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1084 \uc0\u1089 \uc0\u1074 \uc0\u1103 \uc0\u1079 \uc0\u1100 \uc0\u1073 \uc0\u1072 \uc0\u1085 \uc0\u1082 , \uc0\u1055 \uc0\u1040 \uc0\u1054 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , www.psbank.ru/job}\par{\fs18 \uc0\u1060 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1041 \uc0\u1072 \uc0\u1085 \uc0\u1082 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1077 \uc0\u1088 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1050 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}{\line}- \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1083 \uc0\u1072  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085  \uc0\u1082 \uc0\u1083 \uc0\u1102 \uc0\u1095 \uc0\u1077 \uc0\u1074 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072  \uc0\u8212  \uc0\u1074 \uc0\u1099 \uc0\u1073 \uc0\u1086 \uc0\u1088  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1082 \uc0\u1072 \uc0\u1088 \uc0\u1090  \uc0\u1074  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1077 \uc0\u1090 -\uc0\u1073 \uc0\u1072 \uc0\u1085 \uc0\u1082 \uc0\u1077 . \uc0\u1059 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1080 \uc0\u1083 \uc0\u1072  UX, \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1080 \uc0\u1075 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1102  \uc0\u1080  \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1083 \uc0\u1100 , \uc0\u1089  \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1087 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1077 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1076  web, mobile \uc0\u1080  \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1074 , \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1080 \uc0\u1074  \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1080  \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1093  \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1072 \uc0\u1093 , \uc0\u1089 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1089 \uc0\u1080 \uc0\u1083 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1080 \uc0\u1102 .{\line}{\line}- \uc0\u1056 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083  \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1077  \uc0\u8212  \uc0\u1074 \uc0\u1099 \uc0\u1073 \uc0\u1086 \uc0\u1088  \uc0\u1086 \uc0\u1092 \uc0\u1080 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1073 \uc0\u1072 \uc0\u1085 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1077  \uc0\u1089  \uc0\u1092 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1077 \uc0\u1081 . \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  UI-\uc0\u1082 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1099 , \uc0\u1092 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1088 \uc0\u1099  \uc0\u1080  \uc0\u1102 \uc0\u1079 \uc0\u1077 \uc0\u1088 \uc0\u1092 \uc0\u1083 \uc0\u1086 \uc0\u1091 .{\line}{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1079 , \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1083 \uc0\u1100  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1091 \uc0\u1102  \uc0\u1084 \uc0