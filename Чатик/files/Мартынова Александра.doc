60  \uc0\u1057 \uc0\u1072 \uc0\u1092 \uc0\u1084 \uc0\u1072 \uc0\u1088 \par{\cf1 \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1048 \uc0\u1075 \uc0\u1086 \uc0\u1088 \uc0\u1100  (\uc0\u1044 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1072  \uc0\u1076 \uc0\u1077 \uc0\u1087 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072  \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1082 \uc0\u1077 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1072 )}\par\par \uc0\u1040 \uc0\u1083 \uc0\u1100 \uc0\u1092 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1093 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \par{\cf1 \uc0\u1060 \uc0\u1080 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072  \uc0\u1045 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1072  ( \uc0\u1044 \uc0\u1080 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1076 \uc0\u1077 \uc0\u1087 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072  \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1082 \uc0\u1077 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081 )}}\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1073 \uc0\u1086  \uc0\u1084 \uc0\u1085 \uc0\u1077 }\cell\pard\intbl\itap1\sb250\sl260{\fs18 \uc0\u1071  \uc0\u8212  \uc0\u1084 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1080 \uc0\u1076 \uc0\u1080 \uc0\u1089 \uc0\u1094 \uc0\u1080 \uc0\u1087 \uc0\u1083 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085 \uc0\u1077 \uc0\u1088  \uc0\u1089  \uc0\u1089 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \