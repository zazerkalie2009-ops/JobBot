}\cell\pard\intbl\itap1{\fs50\b \uc0\u1048 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1042 \uc0\u1080 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1045 \uc0\u1074 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1100 \uc0\u1077 \uc0\u1074 \uc0\u1080 \uc0\u1095 }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1052 \uc0\u1091 \uc0\u1078 \uc0\u1095 \uc0\u1080 \uc0\u1085 \uc0\u1072 , 29\uc0\u160 \uc0\u1083 \uc0\u1077 \uc0\u1090 , \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1089 \uc0\u1103  29 \uc0\u1072 \uc0\u1074 \uc0\u1075 \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1072  1995}\par\pard\intbl\sl260{\fs18 \par +7\uc0\u160 (915)\uc0\u160 4843931 {\cf1\emdash  \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1100 \uc0\u1073 \uc0\u1072  \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1074  \uc0\u1058 \uc0\u1043 }\par {{\field{\*\fldinst HYPERLINK "mailto:ve.ivanov95@gmail.com"}{\fldrslt\ul ve.ivanov95@gmail.com}}} {\cf1\emdash  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073  \uc0\u1089 \uc0\u1074 \uc0\u1103 \uc0\u1079 \uc0\u1080 }\par \uc0\u1044 \uc0\u1088 \uc0\u1091 \uc0\u1075 \uc0\u1086 \uc0\u1081  \uc0\u1089 \uc0\u1072 \uc0\u1081 \uc0\u1090 : https://t.me/ivanov_ve}\par\pard\intbl\sl260{\fs18 \par \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1077 \uc0\u1090 : \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , \uc0\u1084 . \uc0\u1042 \uc0\u1086 \uc0\u1081 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1103 \par \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 , \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1091 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 \par \uc0\u1053 \uc0\u1077  \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1077 \uc0\u1079 \uc0\u1076 \uc0\u1091 , \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1082 \uc0\u1080 \uc0\u1084  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \uc0\u1084 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1088 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1072 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa100\sl280{\fs24\b \uc0\u1042 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1094  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072  (Product Owner)}\pard\intbl\itap1\sl260{\fs18 \par{\uc0\u1057 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 :  }\par\li300{\uc0\u8212   \uc0\u1052 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1078 \uc0\u1077 \uc0\u1088  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 }\par\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1047 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 : \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \par \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1100 \par \line\uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1074  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1085 \uc0\u1077  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1072  \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1086 \uc0\u1074 }}\cell \row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \emdash 7 \uc0\u1083 \uc0\u1077 \uc0\u1090  10 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1057 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2023 \emdash  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1103 \uc0\u1097 \uc0\u1077 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103 \line 1 \uc0\u1075 \uc0\u1086 \uc0\u1076  6 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\par\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1060 \uc0\u1057 \uc0\u1050  \uc0\u1051 \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1088 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , www.fsk-lider.ru}\par{\fs18 \uc0\u1060 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1102 \uc0\u1097 \uc0\u1072 \uc0\u1103 , \uc0\u1080 \uc0\u1085 \uc0\u1074 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  (\uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1084 \uc0\u1080 )}}\par {\fs18 \uc0\u1057 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 , \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 , \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1083 \uc0\u1091 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1057 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086  \uc0\u1078 \uc0\u1080 \uc0\u1083 \uc0\u1080 \uc0\u1097 \uc0\u1085 \uc0\u1086 \uc0\u1077 }}\par\li300{{\fs18 \uc0\u8226  \uc0\u1040 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1091 \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1075 \uc0\u1080  \uc0\u1074  \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 }}\par\li300{{\fs18 \uc0\u8226  \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1083 \uc0\u1091 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 }}\par\li300{{\fs18 \uc0\u8226  \uc0\u1044 \uc0\u1077 \uc0\u1074 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1087 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 PO/\uc0\u1056 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072  1\uc0\u1057  CRM\par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1056 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1099  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080 , Product Owner \uc0\u1085 \uc0\u1072 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  CRM \uc0\u1057 \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1078 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 .{\line}\uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  2 \uc0\u1084 \uc0\u1083 \uc0\u1088 \uc0\u1076  \uc0\u1088 . \uc0\u1074 \uc0\u1099 \uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1082 \uc0\u1080  \uc0\u1087 \uc0\u1086  \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1091  (DAU 450 \uc0\u1095 \uc0\u1077 \uc0\u1083 ., MAU 700 \uc0\u1095 \uc0\u1077 \uc0\u1083 .);{\line}{\line}\uc0\u1044 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}- \uc0\u1057 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1083  \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1099  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1091  \uc0\u1074 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1103 \uc0\u1097 \uc0\u1080 \uc0\u1093  \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1100 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  50% (\uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  2000 \uc0\u1095 ./\uc0\u1095 \uc0\u1072 \uc0\u1089 . \uc0\u1087 \uc0\u1086  \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1091 ) \uc0\u1079 \uc0\u1072  \uc0\u1089 \uc0\u1095 \uc0\u1077 \uc0\u1090  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084  (\uc0\u1041 \uc0\u1048 \uc0\u1058 -CRM \uc0\u1089  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1096 \uc0\u1080 \uc0\u1085 \uc0\u1099  Datareon) \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1072  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1074  \uc0\u1088 \uc0\u1077 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1077  \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1086 \uc0\u1082 \uc0\u1085 \uc0\u1072 ;{\line}- \uc0\u1059 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1080 \uc0\u1083  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1080 \uc0\u1102 /\uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1089 \uc0\u1085 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1086 \uc0\u1090 \uc0\u1090 \uc0\u1086 \uc0\u1082 \uc0\u1072  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  10% \uc0\u1079 \uc0\u1072  \uc0\u1089 \uc0\u1095 \uc0\u1077 \uc0\u1090  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1082 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078  \uc0\u1085 \uc0\u1072  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1084  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1084  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1080  (\uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1103  \uc0\u1091 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1080 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1077  \uc0\u1089 \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1077 \uc0\u1074  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 );{\line}- \uc0\u1057 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1083  \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1099  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081  \uc0\u1085 \uc0\u1072  30% \uc0\u1079 \uc0\u1072  \uc0\u1089 \uc0\u1095 \uc0\u1077 \uc0\u1090  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074 , \uc0\u1091 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  UX \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1092 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1072 ;{\line}- \uc0\u1059 \uc0\u1074 \uc0\u1077 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1080 \uc0\u1083  CSI \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1089  6 \uc0\u1076 \uc0\u1086  7,8/10;{\line}- \uc0\u1047 \uc0\u1072 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1083  \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1094 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1102  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078  \uc0\u1079 \uc0\u1072  \uc0\u1089 \uc0\u1095 \uc0\u1077 \uc0\u1090  \uc0\u1088 \uc0\u1077 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1099  (\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082  \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1074  2-\uc0\u1093  \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1082 );{\line}- \uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1103 \uc0\u1083  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1082 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1076 \uc0\u1086  90% \uc0\u1079 \uc0\u1072  \uc0\u1089 \uc0\u1095 \uc0\u1077 \uc0\u1090  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1072  Scrum \uc0\u1074  \uc0\u1076 \uc0\u1074 \uc0\u1091 \uc0\u1093  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1093  \uc0\u1089  \uc0\u1085 \uc0\u1091 \uc0\u1083 \uc0\u1103 .{\line}{\line}\uc0\u1054 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 :{\line}- \uc0\u1060 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1073 \uc0\u1101 \uc0\u1082 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1084  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 , \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1082 \uc0\u1080  ICE \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 ;{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1090 \uc0\u1092 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1084  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  (\uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1099 , RoadMap, \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102 );{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1086 \uc0\u1081  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1080 \uc0\u1079  13 \uc0\u1095 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1082  (\uc0\u1085 \uc0\u1072 \uc0\u1081 \uc0\u1084 , \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1077 , 1-1, \uc0\u1089 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1096 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1072 );{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1078 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1081 \uc0\u1082 \uc0\u1093 \uc0\u1086 \uc0\u1083 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1080 \uc0\u1079  \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  \uc0\u1095 \uc0\u1077 \uc0\u1084  10 \uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 : \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1091 \uc0\u1083 \uc0\u1103 \uc0\u1088 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 , \uc0\u1089 \uc0\u1073 \uc0\u1086 \uc0\u1088  \uc0\u1080  \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081 , \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1077 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 , \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1072 , \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074 .{\line}{\line}\uc0\u1057 \uc0\u1090 \uc0\u1101 \uc0\u1082  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1081 : SCRUM, UX/UI \uc0\u1080 \uc0\u1089 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 , CSI \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1099  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081 , \uc0\u1075 \uc0\u1077 \uc0\u1084 \uc0\u1073 \uc0\u1072 , RoadMap \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 , \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1073 \uc0\u1101 \uc0\u1082 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1084 , APDEX, \uc0\u1082 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1089 -\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1077 , \uc0\u1096 \uc0\u1080 \uc0\u1085 \uc0\u1072  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  Datareon, Miro, CJM.}\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1086 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2021 \emdash  \uc0\u1057 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2023\line 1 \uc0\u1075 \uc0\u1086 \uc0\u1076  11 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1060 \uc0\u1057 \uc0\u1050  \uc0\u1051 \uc0\u1080 \uc0\u1076 \uc0\u1077 \uc0\u1088 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , www.fsk-lider.ru}\par{\fs18 \uc0\u1060 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1102 \uc0\u1097 \uc0\u1072 \uc0\u1103 , \uc0\u1080 \uc0\u1085 \uc0\u1074 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  (\uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1084 \uc0\u1080 )}}\par {\fs18 \uc0\u1057 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 , \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 , \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1083 \uc0\u1091 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1057 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086  \uc0\u1078 \uc0\u1080 \uc0\u1083 \uc0\u1080 \uc0\u1097 \uc0\u1085 \uc0\u1086 \uc0\u1077 }}\par\li300{{\fs18 \uc0\u8226  \uc0\u1040 \uc0\u1075 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1091 \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1075 \uc0\u1080  \uc0\u1074  \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 }}\par\li300{{\fs18 \uc0\u8226  \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1101 \uc0\u1082 \uc0\u1089 \uc0\u1087 \uc0\u1083 \uc0\u1091 \uc0\u1072 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 }}\par\li300{{\fs18 \uc0\u8226  \uc0\u1044 \uc0\u1077 \uc0\u1074 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1087 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1042 \uc0\u1077 \uc0\u1076 \uc0\u1091 \uc0\u1097 \uc0\u1080 \uc0\u1081  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082  1\uc0\u1057 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1044 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}- \uc0\u1057 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1083  \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1099  \uc0\u1085 \uc0\u1072  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1091  \uc0\u1087 \uc0\u1072 \uc0\u1082 \uc0\u1077 \uc0\u1090 \uc0\u1072  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1089 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1082 \uc0\u1077  \uc0\u1085 \uc0\u1072  60% \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1103  \uc0\u1089 \uc0\u1086 \uc0\u1079 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1080  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u8220 \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1096 \uc0\u1072 \uc0\u1073 \uc0\u1083 \uc0\u1086 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1076 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u8221 ;{\line}- \uc0\u1057 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1083  \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1082  \uc0\u1089 \uc0\u1086 \uc0\u1075 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1082  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1085 \uc0\u1072  15% \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1103  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1084 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091  \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1084 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1096 \uc0\u1088 \uc0\u1091 \uc0\u1090 \uc0\u1086 \uc0\u1074 ;{\line}- \uc0\u1055 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1077 \uc0\u1083  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1091  \uc0\u1074 \uc0\u1089 \uc0\u1077 \uc0\u1093  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1085 \uc0\u1072  \uc0\u1090 \uc0\u1086 \uc0\u1085 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090  \uc0\u1089  \uc0\u1087 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1097 \uc0\u1100 \uc0\u1102  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  80% \uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1089 \uc0\u1072 \uc0\u1084 \uc0\u1086 \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1092 \uc0\u1080 \uc0\u1075 \uc0\u1091 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 , \uc0\u1095 \uc0\u1090 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1083 \uc0\u1086  \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1075 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1091  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099 ;{\line}- \uc0\u1057 \uc0\u1086 \uc0\u1082 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1083  \uc0\u1085 \uc0\u1072  98% \uc0\u1086 \uc0\u1096 \uc0\u1080 \uc0\u1073 \uc0\u1082 \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1078 \uc0\u1077 \uc0\u1081  \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1103  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1102  QR-\uc0\u1082 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1091  \uc0\u1074  \uc0\u1073 \uc0\u1091 \uc0\u1084 \uc0\u1072 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1093 ;{\line}- \uc0\u1048 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1091  \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1074  \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1091  (\uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  RLS, \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1082 \uc0\u1080  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078  \uc0\u1085 \uc0\u1072  \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1077  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1082 \uc0\u1072 \uc0\u1093  4 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1086 \uc0\u1103 \uc0\u1089 \uc0\u1086 \uc0\u1074 );{\line}- \uc0\u1055 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1077 \uc0\u1083  80% \uc0\u1072 \uc0\u1088 \uc0\u1093 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080 \uc0\u1079  \uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1093 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1083 \uc0\u1080 \uc0\u1097 \uc0\u1072  \uc0\u1074  \uc0\u1077 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1091  CRM \uc0\u1089  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  (\uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074 ).{\line}{\line}\uc0\u1054 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 :{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1082 \uc0\u1072 \uc0\u1084 \uc0\u1080 ;{\line}- \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1100 \uc0\u1102 , \uc0\u1072 \uc0\u1091 \uc0\u1076 \uc0\u1080 \uc0\u1090  \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1080 \uc0\u1085 \uc0\u1078 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 ;{\line}- \uc0\u1056 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1094 \uc0\u1080 \uc0\u1082 \uc0\u1083 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  (\uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1074  BPMN-\uc0\u1085 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 , \uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1076 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1081 \uc0\u1085  \uc0\u1089  \uc0\u1086 \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1080 \uc0\u1079 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1084 \uc0\u1077 \uc0\u1090 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099 , \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 );{\line}- Onboarding \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074  (\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1080 , \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1097 \uc0\u1080 \uc0\u1082 \uc0\u1080 ), \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1100 \uc0\u1102  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074 ;{\line}- \uc0\u1056 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095  CRM \uc0\u1089  \uc0\u1076 \uc0\u1088 \uc0\u1091 \uc0\u1075 \uc0\u1080 \uc0\u1084 \uc0\u1080  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1096 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1080  \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1072 \uc0\u1084 \uc0\u1080  (\uc0\u1085 \uc0\u1072  web-\uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1077 ).{\line}{\line}\uc0\u1057 \uc0\u1090 \uc0\u1101 \uc0\u1082  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1081 : 1\uc0\u1057 , Rest-API, Swagger, Atlassian, Jira, Confluence, HTTP \uc0\u1080  Web-\uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1099 , \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1099  \uc0\u1086 \uc0\u1073 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1072 , Miro. }\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1052 \uc0\u1072 \uc0\u1088 \uc0\u1090  2018 \emdash  \uc0\u1053 \uc0\u1086 \uc0\u1103 \uc0\u1073 \uc0\u1088 \uc0\u1100  2021\line 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072  9 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b 1C-\uc0\u1056 \uc0\u1072 \uc0\u1088 \uc0\u1091 \uc0\u1089 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , job.rarus.ru/}\par{\fs18 \uc0\u1048 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080 , \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 , \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1077 \uc0\u1090 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }}\par\li300{{\fs18 \uc0\u8226  \uc0\u1057 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 ,  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1080  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1103 , \uc0\u1048 \uc0\u1058 -\uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1072 \uc0\u1083 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1056 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1044 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}- \uc0\u1042 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1080 \uc0\u1083  CRM \uc0\u1074  \uc0\u1040 \uc0\u1054  "\uc0\u1042 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1090 \uc0\u1099  \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1080 " - \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 , \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1080 \uc0\u1074 \uc0\u1096 \uc0\u1080 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1102  "\uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090  \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 " \uc0\u1086 \uc0\u1090  \uc0\u1092 \uc0\u1080 \uc0\u1088 \uc0\u1084 \uc0\u1099  1\uc0\u1057 . \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090  \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1083  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1102  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078  \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  \uc0\u1079 \uc0\u1072 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1093  \uc0\u1080  \uc0\u1074  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1102 \uc0\u1097 \uc0\u1077 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 ;{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1083  \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1087 \uc0\u1087 \uc0\u1086 \uc0\u1081  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1084 \uc0\u1086 \uc0\u1073 \uc0\u1080 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  iCRM, \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1103  \uc0\u1095 \uc0\u1077 \uc0\u1084 \uc0\u1091  \uc0\u1073 \uc0\u1099 \uc0\u1083  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085  \uc0\u1088 \uc0\u1103 \uc0\u1076  \uc0\u1072 \uc0\u1088 \uc0\u1093 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1092 \uc0\u1091 \uc0\u1085 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1077 \uc0\u1084 , \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1084 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089  \uc0\u1083 \uc0\u1080 \uc0\u1085 \uc0\u1077 \uc0\u1081 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074  1\uc0\u1057 : CRM;{\line}- \uc0\u1042 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1080 \uc0\u1083  1\uc0\u1057 :\uc0\u1059 \uc0\u1058  \uc0\u1074  \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1086 -\uc0\u1088 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080 , \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089  \uc0\u1089 \uc0\u1083 \uc0\u1091 \uc0\u1078 \uc0\u1073 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1082 \uc0\u1080 , \uc0\u1095 \uc0\u1090 \uc0\u1086  \uc0\u1087 \uc0\u1086 \uc0\u1079 \uc0\u1074 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1083 \uc0\u1086  \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1089 \uc0\u1088 \uc0\u1086 \uc0\u1082  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  20%.{\line}{\line}\uc0\u1054 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 :{\line}- \uc0\u1059 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1077  \uc0\u1074  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1093 ;{\line}- \uc0\u1042 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1087 \uc0\u1080 \uc0\u1089 \uc0\u1082 \uc0\u1080  \uc0\u1089  \uc0\u1051 \uc0\u1055 \uc0\u1056  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 \uc0\u1084 \uc0\u1080 ;{\line}- \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074 , \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1077  \uc0\u1074  \uc0\u1090 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1093 ;{\line}- \uc0\u1057 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 , \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 ;{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072  \uc0\u1055 \uc0\u1054  \uc0\u1080  \uc0\u1077 \uc0\u1075 \uc0\u1086  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 ;{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072  \uc0\u1089 \uc0\u1086  \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084 \uc0\u1080 : \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 ;{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072  \uc0\u1089  \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1088 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080 , \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080 ;{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1086 \uc0\u1084  \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1082 \uc0\u1086 \uc0\u1081  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081  \uc0\u1085 \uc0\u1072  \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1093  \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 , \uc0\u1073 \uc0\u1102 \uc0\u1076 \uc0\u1078 \uc0\u1077 \uc0\u1090  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 .{\line}{\line}\uc0\u1047 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1080 :{\line}\uc0\u1040 \uc0\u1054  \uc0\u171 \uc0\u1042 \uc0\u1077 \uc0\u1088 \uc0\u1090 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1090 \uc0\u1099  \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1080 \uc0\u187 , \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u171 \uc0\u1040 \uc0\u1055 \uc0\u1058 \uc0\u1054 \uc0\u1057  \uc0\u1043 \uc0\u1056 \uc0\u1059 \uc0\u1055 \uc0\u1055 \uc0\u187 , \uc0\u1043 \uc0\u1050  \uc0\u171 FIBERTOOL\uc0\u187 , \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u171 \uc0\u1059 \uc0\u1088 \uc0\u1073 \uc0\u1072 \uc0\u1085 -\uc0\u1043 \uc0\u1088 \uc0\u1091 \uc0\u1087 \uc0\u1087 \uc0\u187 , \uc0\u1043 \uc0\u1050  \uc0\u171 METRO C&C\uc0\u187 , \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u171 \uc0\u1060 \uc0\u1101 \uc0\u1096 \uc0\u1085  \uc0\u1055 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u187 .}\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1052 \uc0\u1072 \uc0\u1081  2017 \emdash  \uc0\u1052 \uc0\u1072 \uc0\u1088 \uc0\u1090  2018\line 11 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1094 \uc0\u1077 \uc0\u1074 }\cell\pard\intbl\itap1\sb250\par\cell\pard\intbl\itap1\sb250\sl280{\fs24\b 1C-\uc0\u1056 \uc0\u1072 \uc0\u1088 \uc0\u1091 \uc0\u1089 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , job.rarus.ru/}\par{\fs18 \uc0\u1048 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080 , \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 , \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1077 \uc0\u1090 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1086 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }}\par\li300{{\fs18 \uc0\u8226  \uc0\u1057 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 ,  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1080  \uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1103 , \uc0\u1048 \uc0\u1058 -\uc0\u1082 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1072 \uc0\u1083 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1075 }}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1090 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1044 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083  \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084 \uc0\u1099  \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \uc0\u1084 \uc0\u1080  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081 ;{\line}- \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1083  \uc0\u1088 \uc0\u1103 \uc0\u1076  \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1081  \uc0\u1074  \uc0\u1092 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1077  \uc0\u1089  \uc0\u1055 \uc0\u1055  1\uc0\u1057 ;{\line}- \uc0\u1056 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1093 \uc0\u1086 \uc0\u1076 \uc0\u1091  \uc0\u1089  Excel \uc0\u1085 \uc0\u1072  1\uc0\u1057  \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1081  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1089  \uc0\u1086 \uc0\u1090 \uc0\u1089 \uc0\u1083 \uc0\u1077 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1091 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1080 \uc0\u1079  \uc0\u1079 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1094 \uc0\u1099 .{\line}{\line}\uc0\u1054 \uc0\u1073 \uc0\u1103 \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 :{\line}- \uc0\u1060 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  (\uc0\u1058 \uc0\u1047 , \uc0\u1063 \uc0\u1058 \uc0\u1047 , \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081 );{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072  \uc0\u1089  \uc0\u1082 \uc0\u1083 \uc0\u1080 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 ;{\line}- \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1074 \uc0\u1080 \uc0\u1076 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1087 \uc0\u1087 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  (\uc0\u1076 \uc0\u1086  40 \uc0\u1095 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1082 );{\line}- \uc0\u1053 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1081 \uc0\u1082 \uc0\u1072  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1087 \uc0\u1086 \uc0\u1076  \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1084 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1074  \uc0\u1085 \uc0\u1077 \uc0\u1081 ;{\line}- \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081  \uc0\u1080  \uc0\u1089 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1074 .{\line}{\line}\uc0\u1047 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1080 :{\line}\uc0\u1058 \uc0\u1044  \uc0\u171 \uc0\u1060 \uc0\u1040 \uc0\u1050 \uc0\u1045 \uc0\u1051 \uc0\u187 , \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u171 \uc0\u1064 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1091 \uc0\u1089 \uc0\u187 , \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u171 \uc0\u1041 \uc0\u1072 \uc0\u1079 \uc0\u1069 \uc0\u1083  \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \uc0\u187 , \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u171 \uc0\u1052 \uc0\u1045 \uc0\u1051 \uc0\u1048 \uc0\u1058 \uc0\u1069 \uc0\u1050 \uc0\u187 , \uc0\u1054 \uc0\u1054 \uc0\u1054  \uc0\u171 \uc0\u1040 \uc0\u1082 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u187 .}\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sl220{\fs22\uc0\u1052 \uc0\u1072 \uc0\u1075 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1088 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2019}\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1090  \uc0\u1076 \uc0\u1088 \uc0\u1091 \uc0\u1078 \uc0\u1073 \uc0\u1099  \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1074 , \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1060 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1082 \uc0\u1086 -\uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1080  \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1085 \uc0\u1072 \uc0\u1091 \uc0\u1082 , \uc0\u1060 \uc0\u1091 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080 .}\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 2017}\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1090  \uc0\u1076 \uc0\u1088 \uc0\u1091 \uc0\u1078 \uc0\u1073 \uc0\u1099  \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1074 , \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1060 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1082 \uc0\u1086 -\uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1080  \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1085 \uc0\u1072 \uc0\u1091 \uc0\u1082 , \uc0\u1060 \uc0\u1091 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1055 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 , \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1099 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2017}\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1059 \uc0\u1095 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  1\uc0\u1057 }\par\pard\intbl\itap1\sl260{\fs18 1\uc0\u1057 , \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1099  1\uc0\u1057 : CRM}\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 2017}\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1059 \uc0\u1095 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  1\uc0\u1057 }\par\pard\intbl\itap1\sl260{\fs18 1\uc0\u1057 , \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1099  1\uc0\u1057 : \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1058 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1081 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 2017}\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1059 \uc0\u1095 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  1\uc0\u1057 }\par\pard\intbl\itap1\sl260{\fs18 1\uc0\u1057 , \uc0\u1050 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1099  1\uc0\u1057 : \uc0\u1048 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1086 \uc0\u1073 \uc0\u1084 \uc0\u1077 \uc0\u1085  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 2016}\cell\pard\intbl\itap1\sb250\sl280{\fs24\b IT-\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1050 \uc0\u1056 \uc0\u1054 \uc0\u1050 }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1050 \uc0\u1056 \uc0\u1054 \uc0\u1050 , \uc0\u1042 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1074  \uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082  Java \uc0\u1080  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1091  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 2016}\cell\pard\intbl\itap1\sb250\sl280{\fs24\b 1\uc0\u1057 -\uc0\u1056 \uc0\u1072 \uc0\u1088 \uc0\u1091 \uc0\u1089 }\par\pard\intbl\itap1\sl260{\fs18 1\uc0\u1057 -\uc0\u1056 \uc0\u1072 \uc0\u1088 \uc0\u1091 \uc0\u1089 , \uc0\u1057 \uc0\u1090 \uc0\u1072 \uc0\u1078 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1087 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1077  \uc0\u1074  1\uc0\u1057 : \uc0\u1055 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1077 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1058 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1099 , \uc0\u1101 \uc0\u1082 \uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1099 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2018}\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1059 \uc0\u1095 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  1\uc0\u1057 }\par\pard\intbl\itap1\sl260{\fs18 1\uc0\u1057 , \uc0\u1069 \uc0\u1082 \uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085  \uc0\u171 1\uc0\u1057 : \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083  \uc0\u1087 \uc0\u1086  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1084  \uc0\u1074 \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1072 \uc0\u1084 \uc0\u187 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 2017}\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1059 \uc0\u1095 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  1\uc0\u1057 }\par\pard\intbl\itap1\sl260{\fs18 1\uc0\u1057 , \uc0\u1069 \uc0\u1082 \uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085  \uc0\u171 1\uc0\u1057 : \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1077 \uc0\u187 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 2017}\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1059 \uc0\u1095 \uc0\u1077 \uc0\u1073 \uc0\u1085 \uc0\u1099 \uc0\u1081  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088  1\uc0\u1057 }\par\pard\intbl\itap1\sl260{\fs18 1\uc0\u1057 , \uc0\u1069 \uc0\u1082 \uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1077 \uc0\u1085  \uc0\u171 1\uc0\u1057 : \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083  \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1081  11\uc0\u187 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1047 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1086 \uc0\u1074 }\cell\pard\intbl\itap1\sl260{\fs18 \uc0\u1056 \uc0\u1091 \uc0\u1089 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  {\cf1\emdash  \uc0\u1056 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1081 }\par \uc0\u1040 \uc0\u1085 \uc0\u1075 \uc0\u1083 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  {\cf1\emdash  B2 \uc0\u8212  \uc0\u1057 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1085 \uc0\u1077 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1085 \uc0\u1091 \uc0\u1090 \uc0\u1099 \uc0\u1081 }}\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\pard\intbl\itap1\sb250\sl260{\fs18 {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \~\uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \~\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1084 }  {\cb5\chcfpat5\chcbpat5 1\uc0\u1057 :\~\uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1058 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1081 }  {\cb5\chcfpat5\chcbpat5 1\uc0\u1057 :\~CRM\~\uc0\u1055 \uc0\u1056 \uc0\u1054 \uc0\u1060 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072 \~\uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093 \~\uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1081 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1042 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1074 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1084 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1084 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \~\uc0\u1073 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1074 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1072 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1041 \uc0\u1080 \uc0\u1079 \uc0\u1085 \uc0\u1077 \uc0\u1089 -\uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1074 \~\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 1\uc0\u1057 :\~\uc0\u1055 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1077 \~8}}\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1044 \uc0\u1086 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1056 \uc0\u1077 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 }\cell\pard\intbl\itap1\sl260{\fs18 \uc0\u1043 \uc0\u1050  \uc0\u1060 \uc0\u1057 \uc0\u1050 \par{\cf1 \uc0\u1051 \uc0\u1077 \uc0\u1090 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1074  \uc0\u1057 \uc0\u1077 \uc0\u1088 \uc0\u1075 \uc0\u1077 \uc0\u1081  \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1077 \uc0\u1074 \uc0\u1080 \uc0\u1095  (CPO \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1072  CRM)}}\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1073 \uc0\u1086  \uc0\u1084 \uc0\u1085 \uc0\u1077 }\cell\pard\intbl\itap1\sb250\sl260{\fs18 \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080  \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090 :{\line}- 1-1, \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1090  \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074 , \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  SCRUM \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077 ;{\line}- \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1081 , \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  \uc0\u1096 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1102  \uc0\u1072 \uc0\u1091 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1102 ;{\line}- \uc0\u1084 \uc0\u1086 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074 ;{\line}- \uc0\u1087 \uc0\u1086 \uc0\u1080 \uc0\u1089 \uc0\u1082  \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1074  \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1088 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1080  \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1080 \uc0\u1090 \uc0\u1091 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 \uc0\u1093 ;{\line}- \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1087 \uc0\u1087 \uc0\u1086 \uc0\u1081  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1076 \uc0\u1086  15 \uc0\u1095 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1082 , \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1073 \uc0\u1102 \uc0\u1076 \uc0\u1078 \uc0\u1077 \uc0\u1090 \uc0\u1072  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 .{\line}{\line}\uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1074 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1080  \uc0\u1089 \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1078 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1055 \uc0\u1055  1\uc0\u1057 :{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1081  8, \uc0\u1088 \uc0\u1077 \uc0\u1076 . 10/11;{\line}- \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1094 \uc0\u1072  8, \uc0\u1088 \uc0\u1077 \uc0\u1076 . 2;{\line}- \uc0\u1050 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1089 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1072 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103  8, \uc0\u1088 \uc0\u1077 \uc0\u1076  2;{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1077 \uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1096 \uc0\u1086 \uc0\u1081  \uc0\u1092 \uc0\u1080 \uc0\u1088 \uc0\u1084 \uc0\u1086 \uc0\u1081  8, \uc0\u1088 \uc0\u1077 \uc0\u1076 . 1;{\line}- CRM 8 \uc0\u1055 \uc0\u1056 \uc0\u1054 \uc0\u1060 , \uc0\u1050 \uc0\u1054 \uc0\u1056 \uc0\u1055 , \uc0\u1088 \uc0\u1077 \uc0\u1076 . 1/2/3;{\line}- \uc0\u1059 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1077 \uc0\u1088 \uc0\u1074 \uc0\u1080 \uc0\u1089 \uc0\u1085 \uc0\u1099 \uc0\u1084  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1084 .{\line}{\line}\uc0\u1059 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 :{\line}- \uc0\u1089 \uc0\u1086 \uc0\u1073 \uc0\u1072 \uc0\u1082 \uc0\u1072  - \uc0\u1054 \uc0\u1050 \uc0\u1044 , \uc0\u1076 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 , \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072  \uc0\u1074  \uc0\u1090 \uc0\u1077 \uc0\u1072 \uc0\u1090 \uc0\u1088 \uc0\u1077  (\uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1082 \uc0\u1083 \uc0\u1100  "\uc0\u1057 \uc0\u1083 \uc0\u1091 \uc0\u1093 \uc0\u1080 ");{\line}- \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1081  \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1084 ;{\line}- \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1103  (\uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1102  \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1099 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1088 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1086 \uc0\u1090 \uc0\u1087 \uc0\u1091 \uc0\u1089 \uc0\u1082 \uc0\u1072 );{\line}- \uc0\u1072 \uc0\u1082 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1091 \uc0\u1084 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1088 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1091 \uc0\u1084 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072  (\uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1077  \uc0\u1076 \uc0\u1077 \uc0\u1089 \uc0\u1103 \uc0\u1090 \uc0\u1080  \uc0\u1083 \uc0\u1077 \uc0\u1090 );}\cell\row\pard}